{
  "expo": {
    "name": "us",
    "slug": "us-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "us",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.us.mobile",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "us needs your location to show you on the map and help friends find each other.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "us uses background location to keep your position updated on the map for your friends.",
        "NSCameraUsageDescription": "us needs camera access to scan QR codes for adding friends."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F1115"
      },
      "package": "com.us.mobile",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "us uses your location to show you on the map for your friends."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "us needs camera access to scan QR codes for adding friends."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#0F1115",
          "resizeMode": "contain"
        }
      ],
      [
        "react-native-maps",
        {
          "androidGoogleMapsApiKey": "AIzaSyDbe2K0Ttie5U24QvxUdRXi_2hFwfTDLEg"
        }
      ],
      "expo-image"
    ]
  }
}
