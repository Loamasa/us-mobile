{
  "expo": {
    "name": "us",
    "slug": "us-mobile",
    "owner": "lomasas-team",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/b9ed9b69-64fc-4c03-89b8-e14a3ee44e9d",
      "fallbackToCacheTimeout": 0
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "us",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.us.mobile",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "us needs your location to show you on the map and help friends find each other.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "us uses background location to keep your position updated on the map for your friends."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F1115"
      },
      "package": "com.us.mobile",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "@sentry/react-native/expo",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "us uses your location to show you on the map for your friends."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "us needs camera access to scan QR codes for adding friends.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#0F1115",
          "resizeMode": "contain"
        }
      ],
      [
        "react-native-maps",
        {
          "androidGoogleMapsApiKey": "AIzaSyDbe2K0Ttie5U24QvxUdRXi_2hFwfTDLEg"
        }
      ],
      "expo-image"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b9ed9b69-64fc-4c03-89b8-e14a3ee44e9d"
      }
    }
  }
}
