rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users: any authenticated user can read profiles, only owner can write
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth.uid == userId;
      allow update: if request.auth.uid == userId;

      // Both friend records must be created while the recipient accepts a pending request.
      match /friends/{friendId} {
        allow read: if request.auth.uid == userId || request.auth.uid == friendId;
        allow create, update: if request.auth != null
          && (request.auth.uid == userId || request.auth.uid == friendId)
          && userId != friendId
          && request.resource.data.status == 'ACTIVE'
          && request.resource.data.requestId is string
          && get(/databases/$(database)/documents/users/$(request.auth.uid)/friendRequests/$(request.resource.data.requestId)).data.status == 'PENDING'
          && get(/databases/$(database)/documents/users/$(request.auth.uid)/friendRequests/$(request.resource.data.requestId)).data.fromUserId == (request.auth.uid == userId ? friendId : userId)
          && get(/databases/$(database)/documents/users/$(request.auth.uid)/friendRequests/$(request.resource.data.requestId)).data.toUserId == request.auth.uid
          && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)/friendRequests/$(request.resource.data.requestId)).data.status == 'ACCEPTED';
        // Either side can end the friendship (removeFriend deletes both records).
        allow delete: if request.auth.uid == userId || request.auth.uid == friendId;
      }

      // Friend requests: creator can create, recipient can read/update
      match /friendRequests/{requestId} {
        allow read: if request.auth.uid == userId
                    || request.auth.uid == resource.data.fromUserId;
        allow create: if request.auth != null
                      && request.resource.data.fromUserId == request.auth.uid
                      && request.resource.data.toUserId == userId
                      && request.auth.uid != userId
                      && request.resource.data.status == 'PENDING';
        allow update: if request.auth.uid == userId
                      && resource.data.status == 'PENDING'
                      && request.resource.data.status in ['ACCEPTED', 'REJECTED']
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      }

      // User spots: only owner can read/write
      match /spots/{spotId} {
        allow read, write: if request.auth.uid == userId;
      }
    }

    // Locations: owner writes; readable only by the owner and their friends
    // (presence of users/{owner}/friends/{reader}). Live position is the most
    // sensitive data in the app — never world-readable.
    match /locations/{userId} {
      allow read: if request.auth != null
                  && (request.auth.uid == userId
                      || exists(/databases/$(database)/documents/users/$(userId)/friends/$(request.auth.uid)));
      allow write: if request.auth.uid == userId;
    }

    // Handle reservation: authenticated users can read (uniqueness check +
    // add-friend lookup happen post-sign-in), creator can create.
    match /handles/{handle} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;
    }

    // Chats: a member can read the summary and write messages. Creation requires
    // the caller to include themselves in memberIds and set createdBy to their uid.
    match /chats/{chatId} {
      // resource == null permits the deterministic-id get-or-create probe
      // (getOrCreateDmChat getDocs a doc that may not exist yet).
      allow read: if request.auth != null
                  && (resource == null
                      || request.auth.uid in resource.data.memberIds);
      allow create: if request.auth != null
                    && request.resource.data.createdBy == request.auth.uid
                    && request.auth.uid in request.resource.data.memberIds;
      // Members may only update the last-message preview, or remove themselves.
      allow update: if request.auth != null
                    && request.auth.uid in resource.data.memberIds
                    && (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'lastMessageAt'])
                        // Leave branch: nothing else changed, exactly one entry
                        // fewer, nobody added, and the removed member is the caller.
                        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds'])
                            && request.resource.data.memberIds.size() == resource.data.memberIds.size() - 1
                            && request.resource.data.memberIds.toSet().difference(resource.data.memberIds.toSet()).size() == 0
                            && resource.data.memberIds.toSet().difference(request.resource.data.memberIds.toSet()).hasOnly([request.auth.uid])));

      match /messages/{messageId} {
        allow read: if request.auth != null
                    && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.memberIds;
        allow create: if request.auth != null
                      && request.resource.data.senderId == request.auth.uid
                      && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.memberIds;
      }
    }

    // Gatherings (collection name: broadcasts). MEMBERS visibility = only
    // members and invitees can see the pin/roster. FRIENDS visibility (solo
    // gathering) = additionally readable by the creator's friends, so they
    // can see the spot and whether the creator is there. Creation requires
    // the caller to be the creator and a member. Invitees may only move
    // themselves out of invitedIds (into memberIds or not); members may only
    // attach the spawned chatId.
    match /broadcasts/{broadcastId} {
      allow read: if request.auth != null
                  && (request.auth.uid in resource.data.memberIds
                      || request.auth.uid in resource.data.invitedIds
                      || (resource.data.visibility == 'FRIENDS'
                          && exists(/databases/$(database)/documents/users/$(resource.data.createdBy)/friends/$(request.auth.uid))));
      allow create: if request.auth != null
                    && request.resource.data.createdBy == request.auth.uid
                    && request.auth.uid in request.resource.data.memberIds;
      allow update: if request.auth != null && (
        (request.auth.uid in resource.data.memberIds
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['chatId']))
        || (request.auth.uid in resource.data.invitedIds
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'invitedIds'])
          && request.resource.data.memberIds.toSet().difference(resource.data.memberIds.toSet()).hasOnly([request.auth.uid])
          && resource.data.memberIds.toSet().difference(request.resource.data.memberIds.toSet()).size() == 0
          && resource.data.invitedIds.toSet().difference(request.resource.data.invitedIds.toSet()).hasOnly([request.auth.uid])
          && request.resource.data.invitedIds.toSet().difference(resource.data.invitedIds.toSet()).size() == 0)
      );
      allow delete: if request.auth != null
                    && request.auth.uid == resource.data.createdBy;
    }
  }
}
