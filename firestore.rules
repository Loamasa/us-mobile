rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Consent proof for joining someone else's friend list. The accepter
    // (caller) may write their entry into the SENDER's list (ownerId) only in
    // the batch that accepts the sender's request: the friend doc cites the
    // request in the caller's own inbox, the request came from ownerId, and it
    // goes PENDING → ACCEPTED in this very write (get = before, getAfter =
    // after). Reusing an already-answered request is therefore impossible.
    function acceptsRequestFrom(ownerId) {
      let requestPath = /databases/$(database)/documents/users/$(request.auth.uid)/friendRequests/$(request.resource.data.get('requestId', ''));
      return request.resource.data.get('requestId', null) is string
             && exists(requestPath)
             && get(requestPath).data.fromUserId == ownerId
             && get(requestPath).data.status == 'PENDING'
             && getAfter(requestPath).data.status == 'ACCEPTED';
    }

    // The recipient's Settings → "Allow Friend Requests" toggle. A missing
    // profile or setting means requests are allowed (the default).
    function acceptsFriendRequests(userId) {
      let profilePath = /databases/$(database)/documents/users/$(userId);
      return !exists(profilePath)
             || get(profilePath).data.get('settings', {}).get('allowFriendRequests', true) != false;
    }

    // Users: any authenticated user can read profiles, only owner can write
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth.uid == userId;
      allow update: if request.auth.uid == userId;

      // Friends subcollection: users/{owner}/friends/{other} grants `other`
      // read access to the owner's location, so only the owner may create it
      // freely. The other party may write their own entry only with a consent
      // proof (acceptsRequestFrom) — that is how acceptFriendRequest's batch
      // writes into BOTH lists. Either party may delete (unfriending is
      // one-sided).
      match /friends/{friendId} {
        allow read: if request.auth.uid == userId || request.auth.uid == friendId;
        allow create, update: if request.auth.uid == userId
                              || (request.auth.uid == friendId && acceptsRequestFrom(userId));
        allow delete: if request.auth.uid == userId || request.auth.uid == friendId;
      }

      // Friend requests: the sender creates a PENDING request addressed to
      // this inbox (never to themselves, only if the recipient allows
      // requests). The recipient may only answer it: status PENDING →
      // ACCEPTED / REJECTED, no other field, no reopening.
      match /friendRequests/{requestId} {
        allow read: if request.auth.uid == userId
                    || request.auth.uid == resource.data.fromUserId;
        allow create: if request.auth != null
                      && request.auth.uid != userId
                      && request.resource.data.fromUserId == request.auth.uid
                      && request.resource.data.toUserId == userId
                      && request.resource.data.status == 'PENDING'
                      && acceptsFriendRequests(userId);
        allow update: if request.auth.uid == userId
                      && resource.data.status == 'PENDING'
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
                      && request.resource.data.status in ['ACCEPTED', 'REJECTED'];
      }

      // User spots: only owner can read/write
      match /spots/{spotId} {
        allow read, write: if request.auth.uid == userId;
      }
    }

    // Locations: owner writes; readable only by the owner and their friends
    // (presence of users/{owner}/friends/{reader}). Live position is the most
    // sensitive data in the app — never world-readable.
    match /locations/{userId} {
      allow read: if request.auth != null
                  && (request.auth.uid == userId
                      || exists(/databases/$(database)/documents/users/$(userId)/friends/$(request.auth.uid)));
      allow write: if request.auth.uid == userId;
    }

    // Handle reservation: authenticated users can read (uniqueness check +
    // add-friend lookup happen post-sign-in), creator can create.
    match /handles/{handle} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;
    }

    // Chats: a member can read the summary and write messages. Creation requires
    // the caller to include themselves in memberIds and set createdBy to their uid.
    match /chats/{chatId} {
      // resource == null permits the deterministic-id get-or-create probe
      // (getOrCreateDmChat getDocs a doc that may not exist yet).
      allow read: if request.auth != null
                  && (resource == null
                      || request.auth.uid in resource.data.memberIds);
      allow create: if request.auth != null
                    && request.resource.data.createdBy == request.auth.uid
                    && request.auth.uid in request.resource.data.memberIds;
      // Members may update only the last-message preview (sendMessage) — no
      // rewriting the creator, renaming, or adding members (a new member
      // would see the whole history). The only other update is the leave
      // branch: the ONLY affected field is memberIds and the only removed
      // member is yourself (no vandalizing the name on the way out, no
      // kicking others).
      allow update: if request.auth != null
                    && request.auth.uid in resource.data.memberIds
                    && (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'lastMessageAt'])
                        // Leave branch (caller absent from the new list):
                        // nothing else changed, exactly one entry fewer (kills
                        // reorder-only and duplicate-padding writes), nobody
                        // added, and the removed member is the caller.
                        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds'])
                            && request.resource.data.memberIds.size() == resource.data.memberIds.size() - 1
                            && request.resource.data.memberIds.toSet().difference(resource.data.memberIds.toSet()).size() == 0
                            && resource.data.memberIds.toSet().difference(request.resource.data.memberIds.toSet()).hasOnly([request.auth.uid])));

      match /messages/{messageId} {
        allow read: if request.auth != null
                    && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.memberIds;
        allow create: if request.auth != null
                      && request.resource.data.senderId == request.auth.uid
                      && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.memberIds;
      }
    }

    // Gatherings (collection name: broadcasts). MEMBERS visibility = only
    // members and invitees can see the pin/roster. FRIENDS visibility (solo
    // gathering) = additionally readable by the creator's friends, so they
    // can see the spot and whether the creator is there. Creation requires
    // the caller to be the creator and a member. Updates are limited to two
    // shapes: an invitee answers for THEMSELVES (leaves invitedIds, and joins
    // memberIds on accept — nobody else added or removed), or a member links
    // the spawned group chat (chatId only).
    match /broadcasts/{broadcastId} {
      allow read: if request.auth != null
                  && (request.auth.uid in resource.data.memberIds
                      || request.auth.uid in resource.data.invitedIds
                      || (resource.data.visibility == 'FRIENDS'
                          && exists(/databases/$(database)/documents/users/$(resource.data.createdBy)/friends/$(request.auth.uid))));
      allow create: if request.auth != null
                    && request.resource.data.createdBy == request.auth.uid
                    && request.auth.uid in request.resource.data.memberIds;
      allow update: if request.auth != null
                    && ((request.auth.uid in resource.data.invitedIds
                         && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'invitedIds'])
                         && request.resource.data.invitedIds.size() == resource.data.invitedIds.size() - 1
                         && resource.data.invitedIds.toSet().difference(request.resource.data.invitedIds.toSet()).hasOnly([request.auth.uid])
                         && request.resource.data.invitedIds.toSet().difference(resource.data.invitedIds.toSet()).size() == 0
                         && request.resource.data.memberIds.size() <= resource.data.memberIds.size() + 1
                         && request.resource.data.memberIds.toSet().difference(resource.data.memberIds.toSet()).hasOnly([request.auth.uid])
                         && resource.data.memberIds.toSet().difference(request.resource.data.memberIds.toSet()).size() == 0)
                        || (request.auth.uid in resource.data.memberIds
                            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['chatId'])));
      allow delete: if request.auth != null
                    && request.auth.uid == resource.data.createdBy;
    }
  }
}
