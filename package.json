{
  "name": "us-mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "seed": "node src/dev/runSeed.js",
    "freshen": "node src/dev/freshenLocations.js --watch",
    "verify": "npm run build:checks && node src/dev/verifyProjection.js && node src/dev/verifyGroupPins.js && node src/dev/verifyRules.js",
    "emulators": "firebase emulators:start --project demo-us-app",
    "build:checks": "tsc -p tsconfig.checks.json",
    "test": "npm run build:checks && node --test tests/map.test.cjs tests/metro-proxy.test.cjs",
    "test:rules": "node --test --test-concurrency=1 tests/security.rules.test.cjs",
    "check:emulators": "firebase emulators:exec --only auth,firestore --project demo-us-app \"npm run seed && npm run verify && npm run verify:sdk && npm run test:rules\"",
    "android:cloud": "npx eas-cli@25.3.0 build --platform android --profile development",
    "apk": "npx eas-cli@25.3.0 build --platform android --profile preview",
    "start:dev": "expo start --dev-client",
    "verify:sdk": "node tests/firebase-sdk.cjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.15",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@sentry/react-native": "~8.28.0",
    "babel-preset-expo": "~58.0.0",
    "expo": "~58.0.21",
    "expo-application": "~58.1.2",
    "expo-blur": "~58.0.5",
    "expo-camera": "~58.0.14",
    "expo-constants": "~58.0.13",
    "expo-dev-client": "~58.0.17",
    "expo-font": "~58.0.10",
    "expo-image": "~58.0.18",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.15",
    "expo-location": "~58.0.20",
    "expo-router": "~58.0.28",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-task-manager": "~58.0.12",
    "expo-updates": "~58.0.19",
    "firebase": "^12.19.0",
    "geofire-common": "^6.0.0",
    "nativewind": "^4.2.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-maps": "1.29.11",
    "react-native-qrcode-svg": "^6.3.27",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.3.0",
    "firebase-tools": "15.34.1",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "@firebase/firestore": {
      "@grpc/grpc-js": "1.14.6"
    },
    "postcss": "8.5.31",
    "tailwindcss": {
      "postcss-selector-parser": "7.1.7"
    },
    "@expo/ngrok": {
      "uuid": "11.1.1"
    },
    "gaxios": {
      "uuid": "11.1.1"
    },
    "postcss-nested": {
      "postcss-selector-parser": "7.1.7"
    }
  },
  "private": true,
  "engines": {
    "node": "22.x"
  }
}
